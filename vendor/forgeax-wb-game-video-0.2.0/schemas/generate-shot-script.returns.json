{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wb-game-video:generate-shot-script returns",
  "type": "object",
  "additionalProperties": true,
  "required": ["shots"],
  "properties": {
    "shots": {
      "type": "array",
      "description": "Seedance V2 shot-script entries for this node.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["shotNumber", "durationSeconds", "seedancePrompt"],
        "properties": {
          "shotNumber": { "type": "number" },
          "durationSeconds": { "type": "number" },
          "seedancePrompt": { "type": "string" },
          "dialogueLine": { "type": "string" },
          "voiceover": { "type": "string" }
        }
      }
    },
    "error": { "type": "string" }
  }
}
