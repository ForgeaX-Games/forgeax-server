{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgeax.asset3d-search-receipt/1.0.0",
  "title": "ForgeaX Asset3D Search Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "providerCommit",
    "originSetDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "forgeax.asset3d-search-receipt/1.0.0"
    },
    "provider": {
      "const": "ea-3d"
    },
    "providerCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "originSetDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
